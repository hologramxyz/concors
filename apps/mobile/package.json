{
  "name": "@concors/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "pnpm assets && expo start --dev-client",
    "demo": "pnpm assets && node scripts/demo.mjs",
    "web": "pnpm assets && expo start --web",
    "android": "pnpm assets && expo run:android",
    "ios": "pnpm assets && expo run:ios",
    "ios:local": "node scripts/ios-local.mjs",
    "assets": "node scripts/production-guard.mjs && node scripts/assets.mjs",
    "build": "pnpm assets && expo export --platform all",
    "typecheck": "pnpm assets && tsc --noEmit",
    "test": "vitest run",
    "live:preflight": "node scripts/live-preflight.mts",
    "release:check": "node scripts/release-check.mjs",
    "candidate:check": "node scripts/release-check.mjs --candidate",
    "testflight:check": "node --env-file-if-exists=.env.local scripts/testflight-check.mjs",
    "eas-build-post-install": "pnpm assets",
    "eas-build-pre-install": "node scripts/production-guard.mjs"
  },
  "dependencies": {
    "@concors/api-client": "workspace:*",
    "@concors/client-core": "workspace:*",
    "@concors/daemon-client": "workspace:*",
    "@concors/protocol": "workspace:*",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/ui": "~57.0.17",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~57.0.21",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.0",
    "sharp": "^0.34.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  }
}
