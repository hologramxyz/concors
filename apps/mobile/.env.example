# Public configuration only. Never put API, Apple, Google, or daemon secrets here.
EXPO_PUBLIC_API_URL=https://api.concors.dev
EXPO_PUBLIC_DEMO=false
# Public identifiers for https://expo.dev/accounts/opser/projects/concors.
# Override both when using a different Expo project.
EXPO_PUBLIC_EAS_PROJECT_ID=cbfccc75-202c-461c-a19d-46419a248dcd
# Required explicitly by candidate/production configuration checks.
EXPO_OWNER=opser
# Optional direct desktop test, development/preview only; no cloud login or API calls.
# Keep DEMO=false. Use a restricted private WSS tunnel, never a public bare daemon.
# EXPO_PUBLIC_DEV_DAEMON_URL=wss://your-device.your-tailnet.ts.net:8444/desktop-daemon/ws
