# Public configuration only. Never put API, Apple, Google, or daemon secrets here.
EXPO_PUBLIC_API_URL=https://api.concors.dev
EXPO_PUBLIC_DEMO=false
# Obtain from your own Expo project; required for push and EAS distribution.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Optional in development only: a daemon behind your authenticated staging tunnel.
# EXPO_PUBLIC_DEV_DAEMON_URL=wss://your-staging-gateway.example/ws
