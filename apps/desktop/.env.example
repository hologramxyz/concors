# Copy to `.env.local` (git-ignored) and adjust. Only VITE_* variables reach the frontend bundle —
# never put secrets here; they would ship to every user.

# Concors control-plane API (https://api.concors.dev in production). Accounts, organizations and
# cloud machines live there; see docs/auth.md.
VITE_CONCORS_API_URL=http://localhost:3000

# Development only: make the Vite dev server forward /api/* to a real API so the browser preview
# talks to it same-origin (session cookies work, no CORS setup needed). Pair it with
# VITE_CONCORS_API_URL=http://localhost:1420 so the app calls the dev server itself.
# CONCORS_API_PROXY_TARGET=https://concors-server-dev.up.railway.app

# Optional: connect to a specific daemon instead of the auto-managed local one.
# Useful when running `pnpm daemon:dev` on a custom port, or to point at a remote daemon.
# VITE_CONCORS_DAEMON_URL=ws://127.0.0.1:7420/ws
# VITE_CONCORS_DAEMON_URL=wss://remote-daemon.example/ws
