    "targets": ["app", "dmg"],
    "resources": {
      "resources/local-daemon/concors-daemon/": "daemon/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5",
      "hardenedRuntime": true,
      "entitlements": "macos/app.entitlements",
