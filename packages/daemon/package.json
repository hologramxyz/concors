{
  "name": "@concors/daemon",
  "version": "0.6.3",
  "private": true,
  "description": "Concors daemon: the long-lived runtime that hosts coding-agent sessions, locally or on a VPS.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "concors-daemon": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning src/cli.ts serve",
    "build": "tsup",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package:linux": "node scripts/package-release.ts linux-x64",
    "package:macos": "node scripts/package-release.ts darwin"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.17.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.246",
    "@concors/protocol": "workspace:*",
    "@fastify/websocket": "^11.3.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "cross-spawn": "7.0.6",
    "fastify": "^5.12.3",
    "jose": "^6.2.12",
    "sherpa-onnx-node": "1.13.8",
    "undici": "7.29.1",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@concors/daemon-client": "workspace:*",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
