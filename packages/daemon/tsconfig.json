{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    // Node-accurate resolution: relative imports must carry their `.ts` extension, exactly as the
    // runtime (`node src/cli.ts`) requires.
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": ["src", "scripts", "tsup.config.ts", "vitest.config.ts"]
}
