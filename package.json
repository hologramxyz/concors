{
  "name": "concors",
  "version": "0.1.0",
  "private": true,
  "description": "A cross-platform client and runtime for orchestrating coding agents locally and in the cloud.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "desktop:dev": "pnpm --filter @concors/desktop dev",
    "desktop:build": "pnpm --filter @concors/desktop build",
    "desktop:package:linux": "node apps/desktop/scripts/package-linux.ts",
    "desktop:release:linux": "node apps/desktop/scripts/release-tarball.ts",
    "desktop:web:dev": "pnpm --filter @concors/desktop web:dev",
    "desktop:web:build": "pnpm --filter @concors/desktop web:build",
    "mobile:dev": "pnpm --filter @concors/mobile dev",
    "mobile:demo": "pnpm --filter @concors/mobile demo",
    "mobile:web": "pnpm --filter @concors/mobile web",
    "mobile:build": "pnpm --filter @concors/mobile build",
    "mobile:test": "pnpm --filter @concors/client-core test && pnpm --filter @concors/mobile test",
    "test:mobile:e2e": "playwright test --config apps/mobile/playwright.config.mts",
    "test:mobile:direct": "playwright test --config apps/mobile/playwright.direct.config.mts",
    "daemon:dev": "pnpm --filter @concors/daemon dev",
    "daemon:build": "pnpm --filter @concors/daemon build",
    "daemon:start": "pnpm --filter @concors/daemon start",
    "daemon:test": "pnpm --filter @concors/daemon test",
    "test:workspace:e2e": "playwright test",
    "daemon:package": "pnpm daemon:build && pnpm --filter @concors/daemon package:linux",
    "test:mobile:managed": "playwright test --config apps/mobile/playwright.managed.config.mts",
    "test:github:e2e": "pnpm desktop:web:build && playwright test --config playwright.github.config.ts",
    "desktop:reload": "node apps/desktop/scripts/reload.ts"
  },
  "devDependencies": {
    "@concors/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
