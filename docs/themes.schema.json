        },
        "border": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        },
        "accentForeground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        },
        "selection": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        },
        "terminal": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "background",
              "foreground",
              "cursor",
              "selection",
              "black",
              "red",
              "green",
              "yellow",
              "blue",
              "magenta",
